import { TargetItem } from '../common/model/TargetTypes'

@Entry
@Component
struct TargetSetting {
  @StorageLink('targetList') targetList: TargetItem[] = []
  @State newTargetText: string = ''

  // æ·»åŠ æ–°ç›®æ ‡
  private addNewTarget() {
    if (this.newTargetText.trim().length === 0) return
    const newItem: TargetItem = {
      id: Date.now().toString(),
      content: this.newTargetText.trim(),
      isFinished: false
    }
    // ç”¨ concat ç”Ÿæˆæ–°æ•°ç»„ï¼Œç¬¦åˆ ArkTS è¯­æ³•
    this.targetList = this.targetList.concat([newItem])
    this.newTargetText = ''
  }

  // åˆ é™¤ç›®æ ‡
  private deleteTarget(id: string) {
    this.targetList = this.targetList.filter(item => item.id !== id)
  }

  build() {
    Column() {
      // é¡¶éƒ¨å¯¼èˆªæ 
      Stack({ alignContent: Alignment.Center }) {
        Text('ä»Šæ—¥ç›®æ ‡ç®¡ç†')
          .fontSize(22)
          .fontWeight(FontWeight.Medium)

        Row() {
          Image($r('app.media.ic_back'))
            .width(24)
            .height(24)
            .objectFit(ImageFit.Contain)
            .onClick(() => {
              router.back()
            })
          Blank()
        }
        .width('100%')
      }
      .width('100%')
      .padding({ left: 20, right: 20, top: 8, bottom: 0 })

      // ç›®æ ‡åˆ—è¡¨
      Scroll() {
        Column({ space: 12 }) {
          Column({ space: 0 }) {
            ForEach(this.targetList || [], (item: TargetItem, index: number) => {
              Row() {
                Text(item.content)
                  .fontSize(16)
                  .fontColor('#1A1A1A')
                  .layoutWeight(1)

                Text('åˆ é™¤')
                  .fontSize(14)
                  .fontColor('#FF3B30')
                  .onClick(() => {
                    this.deleteTarget(item.id)
                  })
              }
              .width('100%')
              .padding({ top: 14, bottom: 14, left: 16, right: 16 })

              if (index < this.targetList.length - 1) {
                Divider().color('#F0F0F0').margin({ left: 16 })
              }
            }, (item: TargetItem) => item.id)
          }
          .width('100%')
          .backgroundColor('#FFFFFF')
          .borderRadius(16)
          .margin({ top: 12 })
        }
        .width('100%')
        .padding({ left: 20, right: 20, bottom: 20 })
      }
      .layoutWeight(1)
      .scrollBar(BarState.Off)

      // åº•éƒ¨æ–°å¢è¾“å…¥åŒº
      Row({ space: 12 }) {
        TextInput({ placeholder: 'æ·»åŠ æ–°çš„ä»Šæ—¥ç›®æ ‡', text: this.newTargetText })
          .layoutWeight(1)
          .height(44)
          .backgroundColor('#FFFFFF')
          .borderRadius(12)
          .padding({ left: 14, right: 14 })
          .onChange((value: string) => {
            this.newTargetText = value
          })

        Button('æ·»åŠ ')
          .height(44)
          .backgroundColor('#3A8F7E')
          .borderRadius(12)
          .fontSize(15)
          .onClick(() => {
            this.addNewTarget()
          })
      }
      .width('100%')
      .padding({ left: 20, right: 20, bottom: 20, top: 8 })
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F7F8FA')
  }
