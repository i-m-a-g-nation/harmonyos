//# sourceMappingURL=DeviceStatusBar.js.mapÂ‘ÙFE:\hauwei-dev\zuoan\entry\src\main\ets\common\constants\StatusEnum.etsÙLE:\hauwei-dev\zuoan\entry\src\main\ets\common\components\DeviceStatusBar.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂ¹E:\hauwei-dev\zuoan\entry³E:\hauwei-dev\zuoan¥entry¥1.0.0Ô␀␀–ÔrC’²hostDependencyName®hostModuleNameÙ$../common/components/DeviceStatusBar¥entryCÙ$../common/components/DeviceStatusBar¥entryCÙ$../common/components/DeviceStatusBar¥entryCÙ$../common/components/DeviceStatusBar¥entryCÙ$../common/components/DeviceStatusBar¥entryCÙ$../common/components/DeviceStatusBar¥entry¹E:\hauwei-dev\zuoan\entryÃÃÚ­import { BluetoothStatus } from '../constants/StatusEnum'

@Component
export struct DeviceStatusBar {
  @Prop btStatus: BluetoothStatus = BluetoothStatus.DISCONNECTED

  // ç‚¹å‡»å›è°ƒ
  onDeviceClick?: () => void
  onNotifyClick?: () => void
  onSettingClick?: () => void

  // æŒ‰å‹çŠ¶æ€ï¼Œåˆ†åˆ«æ§åˆ¶ä¸¤ä¸ªå›¾æ ‡åŠ¨æ•ˆ
  @State notifyPressed: boolean = false
  @State settingPressed: boolean = false

  private getDotColor(): ResourceColor {
    switch (this.btStatus) {
      case BluetoothStatus.CONNECTED:
        return '#3A8F7E'
      case BluetoothStatus.CONNECTING:
        return '#E2A75C'
      default:
        return '#B0B3B8'
    }
  }

  private getStatusText(): string {
    switch (this.btStatus) {
      case BluetoothStatus.CONNECTED:
        return 'å·¥ä½ç»ˆç«¯å·²è¿æ¥'
      case BluetoothStatus.CONNECTING:
        return 'è¿æ¥ä¸­...'
      case BluetoothStatus.OFF:
        return 'è“ç‰™æœªå¼€å¯'
      default:
        return 'è®¾å¤‡æœªè¿æ¥'
    }
  }

  build() {
    Row() {
      // å·¦ä¾§è®¾å¤‡çŠ¶æ€åŒºåŸŸ
      Row({ space: 10 }) {
        Circle({ width: 10, height: 10 })
          .fill(this.getDotColor())
          .opacity(this.btStatus === BluetoothStatus.CONNECTING ? 0.4 : 1)
          .animation({
            duration: 1000,
            iterations: -1,
            curve: Curve.EaseInOut
          })

        Text(this.getStatusText())
          .fontSize(16)
          .fontColor('#1A1A1A')
          .fontWeight(FontWeight.Medium)
      }
      .onClick(() => {
        this.onDeviceClick?.()
      })

      Blank()

      // å³ä¾§é€šçŸ¥ã€è®¾ç½®å›¾æ ‡
      Row({ space: 20 }) {
        // é€šçŸ¥é“ƒé“›
        Image($r('app.media.message'))
          .width(22)
          .height(22)
          .objectFit(ImageFit.Contain)
          .scale({
            x: this.notifyPressed ? 0.9 : 1,
            y: this.notifyPressed ? 0.9 : 1
          })
          .animation({ duration: 120, curve: Curve.EaseInOut })
          .onTouch((e: TouchEvent) => {
            if (e.type === TouchType.Down) this.notifyPressed = true
            else this.notifyPressed = false
          })
          .onClick(() => {
            this.onNotifyClick?.()
          })

        // è®¾ç½®å›¾æ ‡
        Image($r('app.media.setting'))
          .width(22)
          .height(22)
          .objectFit(ImageFit.Contain)
          .scale({
            x: this.settingPressed ? 0.9 : 1,
            y: this.settingPressed ? 0.9 : 1
          })
          .animation({ duration: 120, curve: Curve.EaseInOut })
          .onTouch((e: TouchEvent) => {
            if (e.type === TouchType.Down) this.settingPressed = true
            else this.settingPressed = false
          })
          .onClick(() => {
            this.onSettingClick?.()
          })
      }
    }
    .width('100%')
    .padding({ left: 20, right: 20, top: 8, bottom: 12 })
  }
